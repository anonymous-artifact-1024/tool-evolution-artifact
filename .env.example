# Variable names for the process environment. A .env file is ignored by Git but
# is not loaded automatically. Never commit or send a real API key.
SANER_LOCAL_API_KEY=
SANER_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
SANER_LOCAL_MODEL=Qwen3-14B

SANER_SERVICE_API_KEY=
SANER_SERVICE_BASE_URL=
SANER_SERVICE_MODEL=qwen-plus-2025-12-01
SANER_SERVICE_ENABLE_THINKING=false
